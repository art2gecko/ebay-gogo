# eBay-GoGo Configuration
# Copy this file to .env and fill in your values
# Leave ALL blank to run in MOCK MODE with realistic generated data

# eBay API Credentials (Browse API with OAuth)
# Get these from https://developer.ebay.com/my/keys
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=

# OAuth token is auto-generated from App ID + Cert ID
# Only set this manually if you need a user-level token for Buy It Now / Make Offer
EBAY_OAUTH_TOKEN=

# eBay environment: PRODUCTION or SANDBOX
# IMPORTANT: Use PRODUCTION for real live search results
EBAY_ENVIRONMENT=PRODUCTION

# Default eBay site (e.g., EBAY-US, EBAY-GB)
EBAY_SITE_ID=EBAY-US

# ============================================================
# Licensing
# ============================================================

# License server base URL (API for trial, activate, validate, deactivate)
LICENSE_SERVER_URL=https://api.example.com/v1

# Purchase page URL (opened in browser when user clicks "Purchase" / "Upgrade")
VITE_PURCHASE_URL=https://example.com/purchase

# Ed25519 public key for verifying license receipts (PEM format, newlines as \n)
LICENSE_PUBLIC_KEY=
