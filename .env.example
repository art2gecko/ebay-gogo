# eBay-GoGo Configuration
# Copy this file to .env and fill in your values
# Leave ALL blank to run in MOCK MODE with realistic generated data

# eBay API Credentials
# Get these from https://developer.ebay.com/my/keys
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=

# eBay OAuth (optional, for Buy It Now / Make Offer)
EBAY_OAUTH_TOKEN=

# eBay environment: PRODUCTION or SANDBOX
EBAY_ENVIRONMENT=SANDBOX

# Default eBay site (e.g., EBAY-US, EBAY-GB)
EBAY_SITE_ID=EBAY-US
